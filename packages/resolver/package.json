{
  "name": "@agtnames/resolver",
  "version": "1.4.1",
  "description": "Resolve and verify .agt agent names against AGT Registry v2 (raw JSON-RPC, no wallet library needed)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "agt-resolve": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/*.test.d.ts",
    "README.md",
    "LICENSE",
    "fixtures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "homepage": "https://agtnames.com/docs/resolver-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agtnames/agt.git",
    "directory": "packages/resolver"
  },
  "keywords": [
    "agt",
    "agent-identity",
    "resolver",
    "agent-card",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent",
    "ai-agents",
    "a2a",
    "polygon",
    "naming",
    "erc-8004"
  ],
  "bugs": {
    "url": "https://github.com/agtnames/agt/issues"
  }
}
