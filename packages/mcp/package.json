{
  "name": "@agtnames/mcp",
  "version": "1.5.2",
  "mcpName": "com.agtnames/agt",
  "description": "MCP server for .agt agent names: resolve, verify and discover agents by name against AGT Registry v2, and (opt-in) write records under an owner-signed session grant. Works with any MCP-compatible client (Claude Code, Cursor, custom agents).",
  "type": "module",
  "bin": {
    "agt-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/*.test.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agtnames/agt.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://agtnames.com/docs/claude-code",
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js",
    "prepublishOnly": "node scripts/check-publish-deps.mjs && npm run build && npm test"
  },
  "dependencies": {
    "@agtnames/resolver": "file:../resolver",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0",
    "@agtnames/countersign": "file:../countersign",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "agt",
    "agent-identity",
    "claude-code",
    "gemini-cli-extension",
    "agent-skills",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent",
    "ai-agents",
    "a2a",
    "polygon",
    "naming",
    "erc-8004"
  ],
  "license": "MIT",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/agtnames/agt/issues"
  }
}
