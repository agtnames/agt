{
  "name": "@agtnames/snap",
  "version": "0.1.1",
  "description": "MetaMask Snap: type name.agt in the send field and pay the name's on-chain address (AGT Registry on Polygon)",
  "main": "./dist/bundle.js",
  "files": [
    "dist",
    "images",
    "snap.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "mm-snap build",
    "start": "mm-snap watch",
    "manifest:check": "mm-snap manifest",
    "manifest:fix": "mm-snap manifest --fix",
    "test": "npm run build && jest",
    "check:deps": "node -e \"const d=require('./package.json').dependencies||{};for(const [k,v] of Object.entries(d)){if(/^(file|link):/.test(v)){console.error(k+' is '+v+': publish with a registry range');process.exit(1)}}\"",
    "prepublishOnly": "npm run check:deps && npm run build && mm-snap manifest && jest"
  },
  "dependencies": {
    "@agtnames/resolver": "^1.4.2",
    "@metamask/snaps-sdk": "^12.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-jest": "^10.2.1",
    "@swc/core": "^1.11.31",
    "@swc/jest": "^0.2.38",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "homepage": "https://agtnames.com/docs/guides/metamask-send",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agtnames/agt.git",
    "directory": "packages/snap"
  },
  "keywords": [
    "agt",
    "agent-identity",
    "metamask",
    "snap",
    "metamask-snap",
    "name-resolution",
    "wallet",
    "agent",
    "ai-agents",
    "polygon",
    "naming",
    "erc-8004"
  ],
  "bugs": {
    "url": "https://github.com/agtnames/agt/issues"
  }
}
